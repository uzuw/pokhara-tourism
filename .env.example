# ---------------------------------------------------------------------------
# Hamro Pokhara — backend configuration
# Copy to .env and fill in:  npm run setup:env   (generates secrets for you)
# ---------------------------------------------------------------------------

# production | development | test
NODE_ENV=development

# --- server -----------------------------------------------------------------
PORT=4000
HOST=0.0.0.0

# --- secrets (REQUIRED in production) ---------------------------------------
# Must be >= 32 chars. Production refuses to boot on a missing/placeholder value.
# Generate:  node scripts/setup_env.js   |   openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES=7d

# --- database ---------------------------------------------------------------
# Absolute path to the SQLite file (defaults to server/data/tourism.db).
# Point this at a mounted volume in Docker/production.
# TOURISM_DB_FILE=/var/lib/hamro-pokhara/tourism.db

# --- reverse proxy ----------------------------------------------------------
# Set to "loopback" (or a hop count) when nginx/Caddy terminates TLS in front,
# so rate limiting sees the real client IP. Never use "true".
TRUST_PROXY=loopback

# --- CORS -------------------------------------------------------------------
# Comma-separated allow-list of browser origins. Empty = same-origin only
# (the recommended setup: serve the Next frontend and the API behind one host).
CORS_ORIGINS=

# --- request limits ---------------------------------------------------------
BODY_LIMIT=64kb
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_MS=900000
REGISTER_RATE_MAX=10
REGISTER_RATE_WINDOW_MS=3600000
WRITE_RATE_MAX=60
WRITE_RATE_WINDOW_MS=60000
# RATE_LIMIT_DISABLED=1     # only for load tests / local benchmarking

# --- responses --------------------------------------------------------------
# gzip trades CPU for bandwidth (~-30% req/s, ~2.4x smaller payloads on this API).
# If your proxy already compresses (nginx gzip on), set COMPRESSION_DISABLED=1.
COMPRESSION_THRESHOLD=4096
COMPRESSION_LEVEL=4
# COMPRESSION_DISABLED=1

# Cache lifetime for the public destination catalogue (seconds, 0 disables).
CATALOGUE_MAX_AGE=60
STATIC_MAX_AGE=7d

# Access logs: 0 keeps warnings/errors only (useful under heavy load).
LOG_REQUESTS=1

# --- frontend (frontend/.env.local) -----------------------------------------
# Origin the browser uses for the API (empty = same origin via the Next proxy).
# NEXT_PUBLIC_API_URL=https://api.example.com
# SITE_URL=https://example.com      # used for canonical URLs, sitemap, OG tags
