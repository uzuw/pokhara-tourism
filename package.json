{
  "name": "pokhara-tourism",
  "version": "1.0.0",
  "description": "Pokhara tourism web app",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:all": "concurrently -n backend,frontend -c blue,teal \"npm run dev\" \"npm --prefix frontend run dev\"",
    "seed": "node server/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand server/tests",
    "test:responsive": "node tests/responsive.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "playwright": "^1.62.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/server/tests/**/*.test.js"
    ],
    "testTimeout": 15000
  }
}
