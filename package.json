{
  "name": "pokhara-tourism",
  "version": "1.0.0",
  "description": "Hamro Pokhara — Pokhara tourism web app (Express API + Next.js frontend)",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:env": "node scripts/setup_env.js",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:all": "concurrently -n backend,frontend -c blue,teal \"npm run dev\" \"npm --prefix frontend run dev\"",
    "seed": "node -e \"const s=require('./server/db').seedIfEmpty(); console.log('destinations seeded:', s)\"",
    "test": "cross-env NODE_ENV=test jest --runInBand server/tests",
    "test:security": "cross-env NODE_ENV=test jest --runInBand server/tests/security.test.js server/tests/security-ratelimit.test.js",
    "test:responsive": "node tests/responsive.mjs",
    "audit": "node scripts/security_audit.mjs",
    "loadtest": "node scripts/loadtest.js",
    "build": "npm --prefix frontend run build",
    "start:web": "npm --prefix frontend run start"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "playwright": "^1.62.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/server/tests/**/*.test.js"
    ],
    "testTimeout": 15000
  }
}
